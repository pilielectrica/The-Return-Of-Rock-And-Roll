code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_5;



void fragment() {
// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


	vec3 n_out4p0;
// ColorFunc:4
	vec3 n_in4p0 = vec3(1.00000, 1.00000, 1.00000);
	{
		vec3 c = n_in4p0;
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out4p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// Input:6
	float n_out6p0 = TIME;


// FloatOp:7
	float n_in7p1 = 4.00000;
	float n_out7p0 = n_out6p0 * n_in7p1;


// FloatFunc:8
	float n_out8p0 = sin(n_out7p0);


// FloatOp:9
	float n_in9p1 = 0.50000;
	float n_out9p0 = n_out8p0 * n_in9p1;


// FloatOp:10
	float n_in10p1 = 0.50000;
	float n_out10p0 = n_out9p0 + n_in10p1;


// Mix:3
	vec2 n_out3p0 = mix(vec2(n_out5p0.xy), vec2(n_out4p0.xy), vec2(n_out10p0));


// Output:0
	COLOR.rgb = vec3(n_out3p0, 0.0);


}
"
