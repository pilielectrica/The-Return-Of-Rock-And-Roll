code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_2;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Compare:3
	float n_in3p1 = 0.90000;
	float n_in3p2 = 0.00001;
	bool n_out3p0 = (abs(n_out2p0.x - n_in3p1) < n_in3p2);

// Input:6
	float n_out6p0 = TIME;


// FloatOp:7
	float n_in7p1 = -4.00000;
	float n_out7p0 = n_out6p0 * n_in7p1;


// FloatFunc:8
	float n_out8p0 = sin(n_out7p0);


// FloatOp:11
	float n_in11p1 = -2.00000;
	float n_out11p0 = n_out8p0 / n_in11p1;


// Mix:4
	vec4 n_out4p0 = mix(vec4(n_out3p0 ? 1.0 : 0.0), vec4(n_out11p0), n_out2p0);


// Output:0
	COLOR.rgb = vec3(n_out4p0.xyz);


}
